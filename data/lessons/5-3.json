{
  "id": "5-3",
  "title": "Use Properties to Multiply by 4",
  "goal": "I can multiply by 4: find the 2s fact, then double it.",
  "catchAll": "Find the 4. Find the 2s fact, then double it.",
  "teacher": [
    {
      "term": "Distributive Property",
      "def": "a multiplication fact can be broken apart into the sum of two other related facts"
    }
  ],
  "glossary": {
    "double": "add a number to itself, like 12 + 12",
    "2s fact": "a fact times 2, like 2 × 6",
    "4s fact": "a fact times 4, like 4 × 6"
  },
  "learn": {
    "screens": [
      {
        "title": "Ready? Warm-up",
        "item": {
          "id": "r1",
          "type": "number",
          "prompt": "2 × 6 = ?",
          "answer": "2 × 6",
          "hints": [
            "2 × 6 means 2 groups of 6.",
            "Double 6: 6 + 6."
          ],
          "mistakes": [
            {
              "when": {
                "answer": 8
              },
              "say": "2 + 6 is 8, but this is times. 2 groups of 6 is 6 + 6."
            }
          ],
          "yes": "Yes! 2 × 6 = 12. That is double 6."
        }
      },
      {
        "title": "Ready? One more",
        "item": {
          "id": "r2",
          "type": "number",
          "prompt": "Double 12 = ?",
          "answer": "12 + 12",
          "hints": [
            "Double means add the number to itself: 12 + 12.",
            "10 + 10 = 20 and 2 + 2 = 4."
          ],
          "mistakes": [
            {
              "when": {
                "answer": 14
              },
              "say": "That is 12 + 2. Double 12 means 12 + 12."
            }
          ],
          "yes": "Yes! 12 + 12 = 24."
        }
      },
      {
        "title": "Two 2s make a 4",
        "text": [
          "4 × 6 means 4 rows of 6.",
          "4 is 2 + 2. So cut the 4 rows into two parts. Each part has 2 rows.",
          "Each part is the 2s fact: 2 × 6 = 12. Two parts make 12 + 12 = 24."
        ],
        "model": {
          "type": "array",
          "rows": 4,
          "cols": 6,
          "cut": {
            "by": "rows",
            "at": 2
          },
          "labels": "facts"
        },
        "caption": "4 × 6 = 2 × 6 + 2 × 6",
        "words": [
          "2s fact",
          "double"
        ]
      },
      {
        "title": "The 4s strategy",
        "teacher": true,
        "text": [
          "Find the 4. Find the 2s fact. Then double it.",
          "It works because 4 rows is 2 rows and 2 more rows. That is the Distributive Property."
        ],
        "pairs": [
          "4 × 6 = (2 × 6) + (2 × 6)",
          "12 + 12 = 24"
        ]
      },
      {
        "title": "Check",
        "item": {
          "id": "l1",
          "type": "choice",
          "prompt": "Which one is equal to 4 × 7?",
          "options": [
            {
              "text": "2 × 7 + 2",
              "why": "The second part must be a whole fact: 2 × 7, not 2."
            },
            {
              "text": "2 × 7 + 2 × 7",
              "correct": true
            },
            {
              "text": "4 + 7",
              "why": "4 × 7 means 4 groups of 7, not 4 + 7."
            },
            {
              "text": "2 × 7 + 1 × 7",
              "why": "2 and 1 make 3, not 4. That is 3 × 7."
            }
          ],
          "target": "4 × 7",
          "yes": "Yes! 2 × 7 + 2 × 7 is 14 + 14. That is 28."
        }
      }
    ]
  },
