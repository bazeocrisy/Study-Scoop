{
  "id": "5-5",
  "title": "Use Properties to Multiply by 8",
  "goal": "I can multiply by 8: double the 4s fact, or add the 5s fact and the 3s fact.",
  "catchAll": "Find the 8. Double the 4s fact, or add the 5s fact and the 3s fact.",
  "teacher": [
    {
      "term": "Distributive Property",
      "def": "a multiplication fact can be broken apart into the sum of two other related facts"
    }
  ],
  "glossary": {
    "4s fact": "a fact times 4, like 4 × 6. Double the 2s fact to find it.",
    "8s fact": "a fact times 8, like 8 × 6",
    "double": "add a number to itself, like 24 + 24"
  },
  "learn": {
    "screens": [
      {
        "title": "Ready? Warm-up",
        "item": {
          "id": "r1",
          "type": "number",
          "prompt": "4 × 6 = ?",
          "answer": "4 × 6",
          "hints": [
            "Find the 2s fact: 2 × 6 = 12.",
            "Double 12: 12 + 12."
          ],
          "mistakes": [
            {
              "when": {
                "answer": 10
              },
              "say": "4 + 6 is 10, but this is times. Double the 2s fact."
            },
            {
              "when": {
                "answer": 12
              },
              "say": "12 is the 2s fact. Double it."
            }
          ],
          "yes": "Yes! 4 × 6 = 24."
        }
      },
      {
        "title": "Ready? One more",
        "item": {
          "id": "r2",
          "type": "number",
          "prompt": "Double 24 = ?",
          "answer": "24 + 24",
          "hints": [
            "Double means add the number to itself: 24 + 24.",
            "20 + 20 = 40 and 4 + 4 = 8."
          ],
          "mistakes": [
            {
              "when": {
                "answer": 26
              },
              "say": "That is 24 + 2. Double 24 means 24 + 24."
            }
          ],
          "yes": "Yes! 24 + 24 = 48."
        }
      },
      {
        "title": "Way 1: 8 is 4 + 4",
        "text": [
          "8 × 7 means 8 rows of 7.",
          "8 is 4 + 4. Cut under row 4.",
          "Each part is the 4s fact: 4 × 7 = 28. Double it: 28 + 28 = 56."
        ],
        "model": {
          "type": "array",
          "rows": 8,
          "cols": 7,
          "cut": {
            "by": "rows",
            "at": 4
          },
          "labels": "facts"
        },
        "caption": "8 × 7 = 4 × 7 + 4 × 7",
        "words": [
          "4s fact",
          "double"
        ]
      },
      {
        "title": "Way 2: 8 is 5 + 3",
        "text": [
          "8 is also 5 + 3. Cut under row 5.",
          "The top part is the 5s fact: 5 × 7 = 35. The bottom part is the 3s fact: 3 × 7 = 21.",
          "Add them: 35 + 21 = 56. Same answer!"
        ],
        "model": {
          "type": "array",
          "rows": 8,
          "cols": 7,
          "cut": {
            "by": "rows",
            "at": 5
          },
          "labels": "facts"
        },
        "caption": "8 × 7 = 5 × 7 + 3 × 7"
      },
      {
        "title": "The 8s strategies",
        "teacher": true,
        "text": [
          "Find the 8. Double the 4s fact.",
          "Or add the 5s fact and the 3s fact. Pick the facts you know best."
        ],
        "pairs": [
          "8 × 7 = (4 × 7) + (4 × 7)",
          "8 × 7 = (5 × 7) + (3 × 7)"
        ]
      },
      {
        "title": "Check",
        "item": {
          "id": "l1",
          "type": "choice",
          "prompt": "Which one is equal to 8 × 6?",
          "options": [
            {
              "text": "4 × 6 + 3 × 6",
              "why": "4 and 3 make 7, not 8."
            },
            {
              "text": "4 × 6 + 4",
              "why": "The second part must be a whole fact: 4 × 6, not 4."
            },
            {
              "text": "8 + 6",
              "why": "8 × 6 means 8 groups of 6, not 8 + 6."
            },
            {
              "text": "4 × 6 + 4 × 6",
              "correct": true
            }
          ],
          "target": "8 × 6",
          "yes": "Yes! 4 × 6 + 4 × 6 is 24 + 24. That is 48."
        }
      }
    ]
