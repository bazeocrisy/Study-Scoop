{
  "id": "5-6",
  "title": "Use Properties to Multiply by 7 and 9",
  "goal": "I can multiply by 7 and 9 by starting with a 5s fact.",
  "catchAll": "Break the 7 into 5 + 2, or the 9 into 5 + 4. Find each part, then add.",
  "teacher": [
    {
      "term": "Distributive Property",
      "def": "a multiplication fact can be broken apart into the sum of two other related facts"
    }
  ],
  "glossary": {
    "5s fact": "a fact times 5, like 5 × 6. Count by 5s.",
    "2s fact": "a fact times 2, like 2 × 6. It is a double.",
    "4s fact": "a fact times 4, like 4 × 6. Double the 2s fact."
  },
  "learn": {
    "screens": [
      {
        "title": "Ready? Warm-up",
        "item": {
          "id": "r1",
          "type": "number",
          "prompt": "5 × 6 = ?",
          "answer": "5 × 6",
          "hints": [
            "Count by 5s six times: 5, 10, 15 …",
            "5 × 6 is 6 fives."
          ],
          "mistakes": [
            {
              "when": {
                "answer": 11
              },
              "say": "5 + 6 is 11, but this is times. Count by 5s six times."
            }
          ],
          "yes": "Yes! 5 × 6 = 30."
        }
      },
      {
        "title": "Ready? One more",
        "item": {
          "id": "r2",
          "type": "number",
          "prompt": "4 × 6 = ?",
          "answer": "4 × 6",
          "hints": [
            "Find the 2s fact: 2 × 6 = 12.",
            "Double it: 12 + 12."
          ],
          "mistakes": [
            {
              "when": {
                "answer": 10
              },
              "say": "4 + 6 is 10, but this is times. Double the 2s fact."
            }
          ],
          "yes": "Yes! 4 × 6 = 24."
        }
      },
      {
        "title": "A 7s fact: 7 is 5 + 2",
        "text": [
          "7 × 6 means 7 rows of 6.",
          "7 is 5 + 2. Cut under row 5.",
          "The top part is the 5s fact: 5 × 6 = 30. The bottom part is the 2s fact: 2 × 6 = 12.",
          "Add them: 30 + 12 = 42."
        ],
        "model": {
          "type": "array",
          "rows": 7,
          "cols": 6,
          "cut": {
            "by": "rows",
            "at": 5
          },
          "labels": "facts"
        },
        "caption": "7 × 6 = 5 × 6 + 2 × 6",
        "words": [
          "5s fact",
          "2s fact"
        ]
      },
      {
        "title": "A 9s fact: 9 is 5 + 4",
        "text": [
          "9 × 6 means 9 rows of 6.",
          "9 is 5 + 4. Cut under row 5.",
          "The top part is the 5s fact: 5 × 6 = 30. The bottom part is the 4s fact: 4 × 6 = 24.",
          "Add them: 30 + 24 = 54."
        ],
        "model": {
          "type": "array",
          "rows": 9,
          "cols": 6,
          "cut": {
            "by": "rows",
            "at": 5
          },
          "labels": "facts"
        },
        "caption": "9 × 6 = 5 × 6 + 4 × 6",
        "words": [
          "4s fact"
        ]
      },
      {
        "title": "Start with a 5s fact",
        "teacher": true,
        "text": [
          "A 7s fact is the 5s fact plus the 2s fact.",
          "A 9s fact is the 5s fact plus the 4s fact.",
          "Both use the Distributive Property."
        ],
        "pairs": [
          "7 × 6 = (5 × 6) + (2 × 6)",
          "9 × 6 = (5 × 6) + (4 × 6)"
        ]
      },
      {
        "title": "Check",
        "item": {
          "id": "l1",
          "type": "choice",
          "prompt": "Which one is equal to 7 × 8?",
          "options": [
            {
              "text": "5 × 8 + 2",
              "why": "The second part must be a whole fact: 2 × 8, not 2."
            },
            {
              "text": "5 × 8 + 2 × 8",
              "correct": true
            },
            {
              "text": "5 × 8 + 1 × 8",
              "why": "5 and 1 make 6, not 7."
            },
            {
              "text": "7 + 8",
              "why": "7 × 8 means 7 groups of 8, not 7 + 8."
            }
          ],
          "target": "7 × 8",
          "yes": "Yes! 5 × 8 + 2 × 8 is 40 + 16. That is 56."
        }
      }
    ]
  },
