{
  "id": "5-2",
  "title": "Use Properties to Multiply by 3",
  "goal": "I can multiply by 3: the 2s fact plus the 1s fact.",
  "catchAll": "Find the 3. Double the other number, then add it once more.",
  "teacher": [
    {
      "term": "Distributive Property",
      "def": "a multiplication fact can be broken apart into the sum of two other related facts"
    },
    {
      "term": "Commutative Property",
      "def": "the order of the factors does not matter. The product will stay the same"
    }
  ],
  "glossary": {
    "2s fact": "a fact times 2, like 2 × 8. It is a double.",
    "1s fact": "a fact times 1, like 1 × 8",
    "double": "add a number to itself"
  },
  "learn": {
    "screens": [
      {
        "title": "Ready? Warm-up",
        "item": {
          "id": "r1",
          "type": "number",
          "prompt": "Double 6 = ?",
          "answer": "6 + 6",
          "hints": [
            "Double means add a number to itself."
          ],
          "mistakes": [
            {
              "when": {
                "answer": 8
              },
              "say": "Double means add a number to itself: 6 + 6."
            }
          ],
          "yes": "Yes! Double 6 is 12."
        }
      },
      {
        "title": "Ready? One more",
        "item": {
          "id": "r2",
          "type": "number",
          "prompt": "How many rows?",
          "model": {
            "type": "array",
            "rows": 3,
            "cols": 6,
            "alt": "Rows of dots. Each row goes across."
          },
          "answer": "3",
          "hints": [
            "A row goes across, from left to right."
          ],
          "mistakes": [
            {
              "when": {
                "answer": 6
              },
              "say": "6 is how many dots are in each row. Count the rows going down."
            }
          ],
          "yes": "Yes! 3 rows."
        }
      },
      {
        "title": "Decompose the 3",
        "text": [
          "3 × 8 means 3 rows of 8.",
          "Decompose 3 into 2 and 1. The top 2 rows are the 2s fact: 2 × 8 = 16.",
          "The bottom row is the 1s fact: 1 × 8 = 8.",
          "Add them: 16 + 8 = 24."
        ],
        "model": {
          "type": "array",
          "rows": 3,
          "cols": 8,
          "cut": {
            "by": "rows",
            "at": 2
          },
          "labels": "facts"
        },
        "caption": "3 × 8 = 2 × 8 + 1 × 8 = 16 + 8 = 24",
        "words": [
          "2s fact",
          "1s fact",
          "double"
        ]
      },
      {
        "title": "The 3s strategy",
        "teacher": true,
        "text": [
          "Find the 3. Double the other number, then add it once more.",
          "Double is the 2s fact. Once more is the 1s fact.",
          "Turn-around: 6 × 3 = 3 × 6. The order changes, the product stays the same."
        ],
        "pairs": [
          "3 × 7 = 2 × 7 + 1 × 7 = 14 + 7 = 21"
        ]
      },
      {
        "title": "Another way: break apart the 7",
        "text": [
          "You can also break apart the other factor. 7 is 5 + 2.",
          "Cut between the columns. The left part is 3 × 5 = 15. The right part is 3 × 2 = 6.",
          "Add: 15 + 6 = 21. The same 21 dots! A correct way always keeps every dot."
        ],
        "model": {
          "type": "array",
          "rows": 3,
          "cols": 7,
          "cut": {
            "by": "cols",
            "at": 5
          },
          "labels": "facts"
        },
        "caption": "3 × 7 = 3 × 5 + 3 × 2"
      },
      {
        "title": "Check",
        "item": {
          "id": "l1",
          "type": "choice",
          "prompt": "Which one is equal to 3 × 8?",
          "target": "3 × 8",
          "options": [
            {
              "text": "2 × 8 + 2 × 8",
              "why": "That's 4 groups of 8. 3 is 2 and 1."
            },
            {
              "text": "1 × 8 + 1 × 8",
              "why": "That's only 2 groups of 8. 3 is 2 and 1."
            },
            {
              "text": "2 × 8 + 1 × 8",
              "correct": true
            },
            {
              "text": "2 × 3 + 1 × 8",
              "why": "Keep 8 in both facts."
            }
          ],
          "yes": "Yes! 16 + 8 = 24."
        }
      }
    ]
  },
