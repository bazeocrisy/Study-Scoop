{
  "id": "5-4",
  "title": "Use Properties to Multiply by 6",
  "goal": "I can multiply by 6: the 5s fact plus one more group, or double the 3s fact.",
  "catchAll": "Find the 6. Use the 5s fact and add one more group, or double the 3s fact.",
  "teacher": [
    {
      "term": "Distributive Property",
      "def": "a multiplication fact can be broken apart into the sum of two other related facts"
    }
  ],
  "glossary": {
    "5s fact": "a fact times 5, like 5 × 7",
    "3s fact": "a fact times 3, like 3 × 7",
    "double": "add a number to itself, like 21 + 21"
  },
  "learn": {
    "screens": [
      {
        "title": "Ready? Warm-up",
        "item": {
          "id": "r1",
          "type": "number",
          "prompt": "5 × 7 = ?",
          "answer": "5 × 7",
          "hints": [
            "Count by 5s seven times: 5, 10, 15 …",
            "5 × 7 is 7 fives."
          ],
          "mistakes": [
            {
              "when": {
                "answer": 12
              },
              "say": "5 + 7 is 12, but this is times. Count by 5s seven times."
            }
          ],
          "yes": "Yes! 5 × 7 = 35."
        }
      },
      {
        "title": "Ready? One more",
        "item": {
          "id": "r2",
          "type": "number",
          "prompt": "3 × 7 = ?",
          "answer": "3 × 7",
          "hints": [
            "Use the 3s strategy: 2 × 7 + 1 × 7.",
            "14 + 7."
          ],
          "mistakes": [
            {
              "when": {
                "answer": 10
              },
              "say": "3 + 7 is 10, but this is times. Double 7, then add 7 once more."
            }
          ],
          "yes": "Yes! 3 × 7 = 21."
        }
      },
      {
        "title": "Way 1: 6 is 5 + 1",
        "text": [
          "6 × 7 means 6 rows of 7.",
          "6 is 5 + 1. Cut under row 5.",
          "The top part is the 5s fact: 5 × 7 = 35. The bottom part is one more group: 1 × 7 = 7.",
          "Add them: 35 + 7 = 42."
        ],
        "model": {
          "type": "array",
          "rows": 6,
          "cols": 7,
          "cut": {
            "by": "rows",
            "at": 5
          },
          "labels": "facts"
        },
        "caption": "6 × 7 = 5 × 7 + 1 × 7",
        "words": [
          "5s fact"
        ]
      },
      {
        "title": "Way 2: 6 is 3 + 3",
        "text": [
          "6 is also 3 + 3. Cut under row 3.",
          "Each part is the 3s fact: 3 × 7 = 21.",
          "Double it: 21 + 21 = 42. Same answer! The dots did not change, only the cut."
        ],
        "model": {
          "type": "array",
          "rows": 6,
          "cols": 7,
          "cut": {
            "by": "rows",
            "at": 3
          },
          "labels": "facts"
        },
        "caption": "6 × 7 = 3 × 7 + 3 × 7",
        "words": [
          "3s fact",
          "double"
        ]
      },
      {
        "title": "The 6s strategies",
        "teacher": true,
        "text": [
          "Find the 6. Use the 5s fact, then add one more group.",
          "Or double the 3s fact. Both ways use the Distributive Property."
        ],
        "pairs": [
          "6 × 7 = (5 × 7) + (1 × 7)",
          "6 × 7 = (3 × 7) + (3 × 7)"
        ]
      },
      {
        "title": "Check",
        "item": {
          "id": "l1",
          "type": "choice",
          "prompt": "Which one is equal to 6 × 8?",
          "options": [
            {
              "text": "5 × 8 + 1",
              "why": "The second part must be a whole fact: 1 × 8, not 1."
            },
            {
              "text": "3 × 8 + 2 × 8",
              "why": "3 and 2 make 5, not 6."
            },
            {
              "text": "5 × 8 + 1 × 8",
              "correct": true
            },
            {
              "text": "6 + 8",
              "why": "6 × 8 means 6 groups of 8, not 6 + 8."
            }
          ],
          "target": "6 × 8",
          "yes": "Yes! 5 × 8 + 1 × 8 is 40 + 8. That is 48."
        }
      }
    ]
  },
